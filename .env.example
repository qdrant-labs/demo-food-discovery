# Qdrant Cloud cluster with Cloud Inference enabled. Querying needs it: the
# functions send text, not vectors, and nothing here can embed.
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Optional; these are the defaults.
# QDRANT_COLLECTION=wolt-clip-ViT-B-32
# CLIP_TEXT_MODEL=qdrant/clip-vit-b-32-text
# FILTER_ENGLISH=true
